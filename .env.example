# Frontend — D' Educationist Accounting
#
# Mode selection (M14):
# - API mode (production path): set VITE_API_URL to the Nest API base (includes /api/v1).
# - Mock mode (local demo only): leave VITE_API_URL unset. Uses Zustand seed data + demo123.
#
# Production builds (vite build / import.meta.env.PROD):
# - Require VITE_API_URL (app shows a config error screen otherwise).
# - Demo-account password shortcuts are hidden; mock login is rejected.
#
# Local API-mode tip: seed users use password ChangeMe123! (see backend seed).

VITE_API_URL=http://localhost:3001/api/v1
